# =============================================================================
# surfaceit — environment template
#
# Copy to .env (gitignored) and fill in the values marked REQUIRED.
# All other values have defaults and are optional.
#
# cp .env.example .env
# =============================================================================

# -----------------------------------------------------------------------------
# PUBLIC (browser-safe) — must be prefixed PUBLIC_
# Never put secrets here. These values are shipped to the client bundle.
# -----------------------------------------------------------------------------

# Base URL or absolute path for the same-origin BFF proxy.
# Optional — default: /api/upstream
PUBLIC_API_URL=/api/upstream

# Minimum log level for the client-side logger.
# Optional — one of: debug | info | warn | error — default: info
PUBLIC_LOG_LEVEL=info

# Human-readable application name used in page titles and meta tags.
# Optional — default: surfaceit
PUBLIC_APP_NAME=surfaceit

# -----------------------------------------------------------------------------
# PRIVATE (server-only) — never prefixed PUBLIC_
# These values never leave the server process. Never commit real values.
# -----------------------------------------------------------------------------

# URL for the goscratch upstream backend. The BFF proxy requires this.
# REQUIRED — example: https://api.yourbackend.com
UPSTREAM_API_URL=https://api.example.com

# Secret used to sign session cookies. Must be at least 32 characters.
# REQUIRED — generate with: openssl rand -hex 32
SESSION_SECRET=replace-me-with-a-32-char-or-longer-secret

# Node runtime environment. Controls HSTS headers, debug logging, etc.
# Optional — one of: development | test | production — default: development
NODE_ENV=development
