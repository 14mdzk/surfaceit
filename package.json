{
	"name": "surfaceit",
	"private": true,
	"version": "0.0.1",
	"type": "module",
	"scripts": {
		"dev": "vite dev",
		"build": "vite build",
		"preview": "vite preview",
		"prepare": "svelte-kit sync && paraglide-js compile --project ./project.inlang --outdir ./src/lib/generated/paraglide && lefthook install || echo ''",
		"i18n:compile": "paraglide-js compile --project ./project.inlang --outdir ./src/lib/generated/paraglide",
		"check": "bun run i18n:compile && svelte-kit sync --mode test && svelte-check --tsconfig ./tsconfig.json",
		"check:watch": "bun run i18n:compile && svelte-kit sync --mode test && svelte-check --tsconfig ./tsconfig.json --watch",
		"lint": "prettier --check . && eslint .",
		"format": "prettier --write .",
		"test": "bun run i18n:compile && vitest run",
		"test:watch": "vitest",
		"test:e2e": "playwright test",
		"codegen": "bun run i18n:compile"
	},
	"devDependencies": {
		"@eslint/js": "^10.0.1",
		"@playwright/test": "^1.59.1",
		"@sveltejs/adapter-node": "^5.5.4",
		"@sveltejs/kit": "^2.57.0",
		"@sveltejs/vite-plugin-svelte": "^7.0.0",
		"@tailwindcss/vite": "^4.2.4",
		"@vitest/ui": "^4.1.5",
		"eslint": "^10.3.0",
		"eslint-config-prettier": "^10.1.8",
		"eslint-plugin-svelte": "^3.17.1",
		"globals": "^17.6.0",
		"jsdom": "^29.1.1",
		"lefthook": "^2.1.6",
		"msw": "^2.14.3",
		"openapi-typescript": "^7.13.0",
		"prettier": "^3.8.3",
		"prettier-plugin-svelte": "^3.5.1",
		"prettier-plugin-tailwindcss": "^0.8.0",
		"svelte": "^5.55.2",
		"svelte-check": "^4.4.6",
		"tailwindcss": "^4.2.4",
		"typescript": "^6.0.2",
		"typescript-eslint": "^8.59.2",
		"vite": "^8.0.7",
		"vitest": "^4.1.5"
	},
	"dependencies": {
		"@inlang/paraglide-js": "^2.18.0",
		"@tanstack/svelte-query": "^6.1.28",
		"pino": "^10.3.1",
		"zod": "^4.4.3"
	}
}
